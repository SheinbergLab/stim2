{
  "components": [
    {
      "id": "stim2",
      "name": "stim2",
      "description": "Stimulus presentation system",
      "repo": "SheinbergLab/stim2",
      "package": "stim2",
      "service": "stim2",
      "assetPattern": "stim2_.*\\.deb$",
      "depends": ["dlsh"]
    },
    {
      "id": "dlsh",
      "name": "dlsh",
      "description": "Tcl zipfs library (shared runtime)",
      "repo": "SheinbergLab/dlsh",
      "assetPattern": "dlsh.*\\.zip$",
      "installCmd": "mkdir -p /usr/local/dlsh && cp {file} /usr/local/dlsh/dlsh.zip && echo {version} > /usr/local/dlsh/VERSION",
      "versionFile": "/usr/local/dlsh/VERSION"
    },
    {
      "id": "dlsh-interp",
      "name": "dlsh interpreter",
      "description": "Standalone dlsh (runs replay and the stim2-render service)",
      "repo": "SheinbergLab/dlsh",
      "package": "dlsh-interp",
      "assetPattern": "dlsh-interp_.*\\.deb$",
      "depends": ["dlsh"],
      "postInstall": [
        "dpkg-query -W -f='${Version}\\n' dlsh-interp > /usr/local/dlsh/VERSION",
        "systemctl try-restart stim2-render"
      ]
    }
  ]
}
