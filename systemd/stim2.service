[Unit]
Description=Stim2 Stimulus Presentation
# Ordered after chrony so the waitsync below has a daemon to ask; harmless
# where the unit does not exist.
After=chrony.service chronyd.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/tmp
# Do not start until chrony has settled the clock: the stim/frame record
# stamps every flip with CLOCK_REALTIME, and dserv on the other host joins
# those to its own timestamps. A clock still being stepped or slewed into
# place after boot moves under the session. waitsync blocks until the
# remaining correction is under 1 ms, once a second for up to 60 s. ALL
# FOUR arguments: the interval defaults to 10 s, so `waitsync 60 0.001`
# alone is a 600 s stall. The `-` lets a host with no chronyc, or no
# reachable time source, start anyway once the 60 s are up.
ExecStartPre=-/usr/bin/chronyc waitsync 60 0.001 0 1
ExecStart=/usr/bin/cage -- /usr/local/stim2/stim2 -F -f /usr/local/stim2/config/linux.cfg
Restart=always
RestartSec=5
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
