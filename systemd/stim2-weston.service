# stim2 under a Weston kiosk session. For platforms where wlroots/cage
# can't run on the vendor GL stack (e.g. NXP i.MX95 with the ARM Mali
# blob), Weston is the vendor-validated compositor; kiosk-shell plus
# [autolaunch] gives the same lifecycle as the cage-based stim2.service.
#
# postinst installs this as /etc/systemd/system/stim2.service on
# Mali-blob boards and seeds /etc/xdg/weston/stim2-kiosk.ini from
# /usr/local/stim2/config/stim2-kiosk.ini; the autolaunch target is
# /usr/local/stim2/stim2-kiosk.sh (both ship in the package).

[Unit]
Description=Stim2 Stimulus Presentation (Weston kiosk)
Conflicts=weston.service weston.socket
Wants=seatd.service
After=seatd.service systemd-user-sessions.service

[Service]
Type=notify
RuntimeDirectory=stim2
Environment=XDG_RUNTIME_DIR=/run/stim2
ExecStart=/usr/bin/weston --log=/run/stim2/weston.log --modules=systemd-notify.so -c /etc/xdg/weston/stim2-kiosk.ini
Restart=always
RestartSec=2
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
