#!/bin/sh

set -e

# Refresh dynamic lib cache for libs installed with package.
ldconfig

# Determine platform-appropriate stim2 service
ARCH=$(dpkg --print-architecture)
if [ "$ARCH" = "arm64" ]; then
    # Boards running a vendor Mali blob (e.g. NXP i.MX95) can't run
    # cage/wlroots (segfaults in the blob's compositor-side EGL/GBM);
    # use the Weston kiosk variant there. Unit name stays 'stim2' either
    # way so stim2-agent/stimctl are unaffected.
    if [ -e /dev/mali0 ] || [ -e /usr/lib/libmali.so.0 ]; then
        STIM2_SVC=stim2-weston.service
    else
        STIM2_SVC=stim2.service
    fi
    STIM2_SVC_NAME=stim2
else
    # X11 flavor lives in the packaged FILE name only; it too installs as
    # stim2.service so 'systemctl start stim2' works on every platform.
    STIM2_SVC=stim2-x11.service
    STIM2_SVC_NAME=stim2
fi

# Migrate legacy installs where the unit was named stim2-x11.service: the
# unit name is now 'stim2' on every platform. Preserves enabled/active
# state (brief stop/start if it was running).
if [ -f /etc/systemd/system/stim2-x11.service ] && [ ! -f /etc/systemd/system/stim2.service ]; then
    WAS_ENABLED=0
    WAS_ACTIVE=0
    if [ -d /run/systemd/system ]; then
        systemctl is-enabled --quiet stim2-x11 2>/dev/null && WAS_ENABLED=1
        systemctl is-active --quiet stim2-x11 2>/dev/null && WAS_ACTIVE=1
        systemctl disable --now stim2-x11 >/dev/null 2>&1 || true
    fi
    mv /etc/systemd/system/stim2-x11.service /etc/systemd/system/stim2.service
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if [ "$WAS_ENABLED" = 1 ]; then systemctl enable stim2 >/dev/null 2>&1 || true; fi
        if [ "$WAS_ACTIVE" = 1 ]; then systemctl start stim2 || true; fi
    fi
    echo "Migrated stim2-x11.service -> stim2.service (state preserved)"
fi

# Repair agent units rendered before the name unification: they have
# '--service stim2-x11' baked in, which left the agent unable to manage
# the unit 'dservctl component update stim2' actually targets.
if [ -f /etc/systemd/system/stim2.service ] \
   && [ -f /etc/systemd/system/stim2-agent.service ] \
   && grep -q -- "--service stim2-x11" /etc/systemd/system/stim2-agent.service; then
    sed -i "s/--service stim2-x11/--service stim2/" /etc/systemd/system/stim2-agent.service
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl try-restart stim2-agent >/dev/null 2>&1 || true
    fi
    echo "Updated stim2-agent.service to --service stim2"
fi

# Render the stim2-agent components configuration with the platform's actual
# unit name. The agent uses comp.Service to restart the right unit after a
# component update and to whitelist start/stop/restart via its API. Re-rendered
# on every configure so upgrades pick up template changes.
mkdir -p /etc/stim2-agent
if [ -f /usr/local/stim2/config/components.json ]; then
    sed "s|\"service\": \"stim2\"|\"service\": \"$STIM2_SVC_NAME\"|g" \
        /usr/local/stim2/config/components.json \
        > /etc/stim2-agent/components.json
fi

# Note: the agent runs unauthenticated by default to keep the bundled web UI
# working (its WebSocket client doesn't carry a Bearer token). If you want
# auth on this box, drop a DSERV_AGENT_TOKEN=... line into /etc/stim2-agent/env
# (mode 600) and restart stim2-agent -- the EnvironmentFile=- in the unit
# makes the file optional, so its presence enables auth. To turn auth back
# off, remove /etc/stim2-agent/env and restart stim2-agent; clients then need
# no token (and the bundled web UI's tokenless WebSocket works again). Note
# dservctl reads its own token from ~/.dservctl / DSERV_AGENT_TOKEN, so clear
# those too when disabling auth to avoid a stale mismatch.

# Ensure the 'stim' system user exists on X11-based systems. Runs on every
# configure (idempotent) so upgrades from hand-crafted installs pick it up too,
# which is what lets a later dpkg-reconfigure install the new User=stim unit
# without failing on a missing account.
if [ "$STIM2_SVC" = "stim2-x11.service" ]; then
    if ! getent passwd stim >/dev/null; then
        adduser --system --group --home /var/lib/stim \
            --shell /usr/sbin/nologin --gecos "stim2 stimulus presentation" stim
        echo "Created system user 'stim'"
    fi

    # Add stim to groups it needs to drive the display, input devices, and audio
    for grp in tty video input audio render; do
        if getent group "$grp" >/dev/null; then
            adduser stim "$grp" >/dev/null 2>&1 || true
        fi
    done

    # Ensure HOME exists with the right ownership (xinit writes .Xauthority here)
    mkdir -p /var/lib/stim
    chown stim:stim /var/lib/stim
fi

# Configure Xwrapper so the non-console 'stim' user can start the X server.
# Trixie ships allowed_users=console, and Xorg's setuid wrapper then refuses
# every start of a systemd-launched xinit -- User=stim owns no VT, so it is not
# a "console user". On the X11 flavor this is a REQUIREMENT of the package, not
# a preference: without it stim2.service does nothing but exit 1 and restart.
#
# The FILE is written first, deliberately. The obvious route -- preseed
# xserver-xorg-legacy/xwrapper/allowed_users, then dpkg-reconfigure -- quietly
# does nothing whenever /etc/X11/Xwrapper.config already exists, which on a box
# that just pulled xserver-xorg-legacy in as our dependency is ALWAYS. That
# package's own .config script reads the existing file and db_set's the question
# from it BEFORE asking, so it overwrites the preseed with the very value we are
# trying to change, and its postinst then writes 'console' straight back. The
# old code reported "Set Xwrapper allowed_users=anybody via debconf" and left
# allowed_users=console behind (dserv-dev, amd64/trixie, 2026-08-24). Writing
# the file and syncing debconf afterwards works WITH that read-back instead of
# against it: a later dpkg-reconfigure now derives "Anybody" from our own file.
#
# Runs on EVERY configure, not first install only. The write is idempotent and
# skipped once the values are right, so the guard it replaces bought nothing --
# while a box already sitting in the broken state had no way to heal but hands.
# The only "admin edit" this overrides is one that stops stim2 starting at all.
if [ "$STIM2_SVC" = "stim2-x11.service" ]; then
    XWRAPPER=/etc/X11/Xwrapper.config

    XW_ALLOWED=""
    if [ -f "$XWRAPPER" ]; then
        XW_ALLOWED=$(sed -n 's/^allowed_users=//p' "$XWRAPPER" | head -n 1)
    fi

    if [ "$XW_ALLOWED" != "anybody" ] || \
       ! grep -q '^needs_root_rights=yes' "$XWRAPPER" 2>/dev/null; then
        mkdir -p /etc/X11
        if [ -f "$XWRAPPER" ] && [ ! -f "$XWRAPPER.stim2-bak" ]; then
            cp "$XWRAPPER" "$XWRAPPER.stim2-bak"
            echo "Backed up existing $XWRAPPER to $XWRAPPER.stim2-bak"
        fi

        if [ -f "$XWRAPPER" ]; then
            # Replace if present, append if missing -- keeps the comment header
            # and any other keys the file carries.
            if grep -q '^allowed_users=' "$XWRAPPER"; then
                sed -i 's/^allowed_users=.*/allowed_users=anybody/' "$XWRAPPER"
            else
                printf 'allowed_users=anybody\n' >> "$XWRAPPER"
            fi
            if grep -q '^needs_root_rights=' "$XWRAPPER"; then
                sed -i 's/^needs_root_rights=.*/needs_root_rights=yes/' "$XWRAPPER"
            else
                printf 'needs_root_rights=yes\n' >> "$XWRAPPER"
            fi
        else
            printf 'allowed_users=anybody\nneeds_root_rights=yes\n' > "$XWRAPPER"
        fi
        chmod 644 "$XWRAPPER"
        echo "Set allowed_users=anybody, needs_root_rights=yes in $XWRAPPER"

        # Sync debconf to what we just wrote. Not required for the running box
        # -- Xorg reads the file, not the database -- but it keeps the next
        # xserver-xorg-legacy upgrade from having an opinion of its own.
        if dpkg -s xserver-xorg-legacy >/dev/null 2>&1 \
           && command -v debconf-set-selections >/dev/null 2>&1; then
            printf '%s\n%s\n' \
"xserver-xorg-legacy xserver-xorg-legacy/xwrapper/allowed_users select Anybody" \
"xserver-xorg-legacy xserver-xorg-legacy/xwrapper/actual_allowed_users string anybody" \
                | debconf-set-selections 2>/dev/null || true
        fi
    fi
fi

# Weston-kiosk variant needs its compositor config; seed it if absent
# (never clobber admin edits, e.g. an [output] mode= line for high refresh).
if [ "$STIM2_SVC" = "stim2-weston.service" ] && [ ! -f /etc/xdg/weston/stim2-kiosk.ini ]; then
    mkdir -p /etc/xdg/weston
    cp /usr/local/stim2/config/stim2-kiosk.ini /etc/xdg/weston/stim2-kiosk.ini
    echo "Installed /etc/xdg/weston/stim2-kiosk.ini"
fi

# udev rule so systemd materializes dev-dri-cardN.device units. Debian's
# systemd tags DRM cards only seat/master-of-seat/uaccess, so the units'
# Wants=dev-dri-card0.device otherwise stalls 90s (DefaultDeviceTimeoutSec)
# on EVERY start -- boot and systemctl alike -- before starting anyway.
# Package-owned path, refreshed on every configure; the reload+trigger makes
# it take effect immediately so first install doesn't need a reboot.
if [ -f /usr/local/stim2/systemd/99-drm-systemd-tag.rules ]; then
    mkdir -p /usr/lib/udev/rules.d
    cp /usr/local/stim2/systemd/99-drm-systemd-tag.rules \
       /usr/lib/udev/rules.d/99-drm-systemd-tag.rules
    if [ -d /run/systemd/system ] && command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload || true
        udevadm trigger --action=change --subsystem-match=drm || true
    fi
fi

# Install stim2 service on first install only (never clobber existing config)
if [ ! -f /etc/systemd/system/stim2.service ] && [ ! -f /etc/systemd/system/stim2-x11.service ]; then
    cp /usr/local/stim2/systemd/$STIM2_SVC /etc/systemd/system/$STIM2_SVC_NAME.service
    echo "Installed $STIM2_SVC as $STIM2_SVC_NAME.service (not enabled)"
    # /run/systemd/system only exists when systemd is the running init system.
    # Skip systemctl calls in build/CI containers where dbus/systemd aren't up.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
    fi
fi

# Bootstrap dlsh if not already installed
if [ ! -f /usr/local/dlsh/dlsh.zip ]; then
    echo "dlsh not found, installing..."
    DLSH_URL=$(curl -s https://api.github.com/repos/SheinbergLab/dlsh/releases/latest \
        | grep "browser_download_url.*dlsh.*\.zip" \
        | head -1 | cut -d'"' -f4)

    if [ -n "$DLSH_URL" ]; then
        DLSH_VER=$(curl -s https://api.github.com/repos/SheinbergLab/dlsh/releases/latest \
            | grep '"tag_name"' | head -1 | cut -d'"' -f4)
        mkdir -p /usr/local/dlsh
        curl -fSL "$DLSH_URL" -o /usr/local/dlsh/dlsh.zip
        echo "$DLSH_VER" > /usr/local/dlsh/VERSION
        echo "Installed dlsh $DLSH_VER to /usr/local/dlsh/"
    else
        echo "Warning: could not determine dlsh download URL"
    fi
fi

# Map dpkg arch to the asset arch slug used in SheinbergLab/dserv releases.
case "$ARCH" in
    amd64) AGENT_ARCH="amd64" ;;
    arm64) AGENT_ARCH="arm64" ;;
    *) AGENT_ARCH="" ;;
esac

# Bootstrap dserv-agent only on standalone stim2 systems (no dserv)
if [ -n "$AGENT_ARCH" ] \
   && ! dpkg -s dserv >/dev/null 2>&1 \
   && ! command -v dserv-agent >/dev/null 2>&1; then
    echo "dserv-agent not found (standalone stim2), installing..."

    AGENT_URL=$(curl -s https://api.github.com/repos/SheinbergLab/dserv/releases/latest \
        | grep "browser_download_url.*dserv-agent_linux_${AGENT_ARCH}" \
        | head -1 | cut -d'"' -f4)

    if [ -n "$AGENT_URL" ]; then
        curl -fSL "$AGENT_URL" -o /usr/local/bin/dserv-agent
        chmod +x /usr/local/bin/dserv-agent
        echo "Installed dserv-agent to /usr/local/bin/dserv-agent"

        if [ ! -f /etc/systemd/system/stim2-agent.service ]; then
            sed "s|__STIM2_SERVICE__|$STIM2_SVC_NAME|g" \
                /usr/local/stim2/systemd/stim2-agent.service \
                > /etc/systemd/system/stim2-agent.service
            if [ -d /run/systemd/system ]; then
                systemctl daemon-reload
                systemctl enable stim2-agent
                systemctl start stim2-agent
            fi
        fi
    else
        echo "Warning: could not determine dserv-agent download URL"
    fi
fi

# Bootstrap dservctl CLI from the same release. stim2-agent speaks the same
# HTTP/WS API as dserv-agent, so dservctl works against either; the stimctl
# shim below just wraps it for the local agent (default port 80).
if [ -n "$AGENT_ARCH" ] && ! command -v dservctl >/dev/null 2>&1; then
    echo "dservctl not found, installing..."
    DCTL_URL=$(curl -s https://api.github.com/repos/SheinbergLab/dserv/releases/latest \
        | grep "browser_download_url.*dservctl_linux_${AGENT_ARCH}" \
        | head -1 | cut -d'"' -f4)
    if [ -n "$DCTL_URL" ]; then
        curl -fSL "$DCTL_URL" -o /usr/local/bin/dservctl
        chmod +x /usr/local/bin/dservctl
        echo "Installed dservctl to /usr/local/bin/dservctl"
    else
        echo "Warning: could not determine dservctl download URL"
    fi
fi

# Convenience wrapper: dservctl pointed at the local stim2-agent (default
# port 80) and auto-loading the agent's bearer token when the caller has
# permission to read /etc/stim2-agent/env (typically only root). When the
# agent runs unauthenticated (no env file) the token is simply absent and
# the wrapper still works.
if [ -x /usr/local/bin/dservctl ] && [ ! -e /usr/local/bin/stimctl ]; then
    cat > /usr/local/bin/stimctl <<'EOF'
#!/bin/sh
# stimctl: dservctl pointed at the local stim2-agent (default port 80).
if [ -z "$DSERV_AGENT_TOKEN" ] && [ -r /etc/stim2-agent/env ]; then
    DSERV_AGENT_TOKEN=$(grep -m1 '^DSERV_AGENT_TOKEN=' /etc/stim2-agent/env | cut -d= -f2-)
    export DSERV_AGENT_TOKEN
fi
exec /usr/local/bin/dservctl "$@"
EOF
    chmod +x /usr/local/bin/stimctl
    echo "Installed stimctl wrapper to /usr/local/bin/stimctl"
fi
